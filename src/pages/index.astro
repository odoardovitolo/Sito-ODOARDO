---
import Base from '../layouts/Base.astro';

// Numero di partita IVA: lascialo vuoto finché non è aperta, il footer lo mostra solo se c'è.
const PIVA = '';
---
<Base
  title="Odoardo Vitolo – Fractional CMO per PMI e professionisti"
  description="Direzione marketing per PMI e professionisti: definisco le priorità, coordino agenzie e specialisti, misuro cosa rende."
>

<div style="font-family: Inter, system-ui, sans-serif; color: var(--ink); background: var(--bg); width: 100%;">

  <!-- NAV -->
  <header style="position: sticky; top: 0; z-index: 20; background: var(--alt); border-bottom: 1px solid var(--line);">
    <nav aria-label="Navigazione principale" style="position: relative; max-width: 1200px; margin: 0 auto; padding: 12px clamp(20px, 4vw, 32px); display: flex; align-items: center; justify-content: center; gap: clamp(16px, 4vw, 48px);">
      <button type="button" data-go="top" aria-label="Torna all'inizio" style="display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--ink); font-family: inherit; cursor: pointer;">
        <svg class="logo-svg" width="32" height="32" viewBox="260 260 1080 1080" aria-hidden="true" style="flex: 0 0 32px; transform-origin: 50% 50%;"><path class="logo-path" pathLength="100" d="M 1100.91 400.68 A 500 500 0 1 1 962.78 327.24" fill="none" stroke="#46C2AF" stroke-width="64" stroke-linecap="butt"></path></svg>
        <span class="nav-name" style="font-weight: 700; font-size: 14px; letter-spacing: 0.08em; white-space: nowrap;">ODOARDO VITOLO</span>
      </button>
      <div style="display: flex; align-items: center; gap: 8px; flex: 0 0 auto;">
        <button type="button" data-action="theme" aria-label="Passa al tema scuro" title="Passa al tema scuro" style="width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0;">
          <span class="only-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </span>
          <span class="only-light">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          </span>
        </button>
        <button type="button" data-action="menu" aria-label="Apri il menu" aria-expanded="false" title="Apri il menu" style="width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0;">
          <span class="when-closed">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </span>
          <span class="when-open">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </span>
        </button>
        <button type="button" data-go="contatti" data-umami-event="cta-header" style="display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 0; background: #46C2AF; color: #FFFFFF; font-family: inherit; font-size: 16px; font-weight: 500; white-space: nowrap; cursor: pointer;">Conosciamoci<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 18px; overflow: visible;"><path d="M4 10h12v3.5a5.5 5.5 0 0 1-5.5 5.5h-1A5.5 5.5 0 0 1 4 13.5V10z"></path><path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"></path><path class="steam-1" d="M8 7c-.9-1 .9-2 0-3.5"></path><path class="steam-2" d="M12 7c-.9-1 .9-2 0-3.5"></path></svg></button>
      </div>
      <div class="when-open">
        <div style="position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); width: 260px; max-width: calc(100% - 40px); background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 8px; display: flex; flex-direction: column; box-shadow: 0 12px 32px rgba(41, 49, 51, 0.12);">
        <button type="button" data-go="da-dove-parti" data-anim="1" style="display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px; border-radius: 10px; border: 0; background: transparent; color: var(--ink); font-family: inherit; font-size: 16px; text-align: left; cursor: pointer;"><span aria-hidden="true" style="flex: 0 0 3px; width: 3px; height: 18px; border-radius: 2px; background: #46C2AF;"></span>Da dove parti?</button>
        <button type="button" data-go="strumenti" data-anim="1" style="display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px; border-radius: 10px; border: 0; background: transparent; color: var(--ink); font-family: inherit; font-size: 16px; text-align: left; cursor: pointer;"><span aria-hidden="true" style="flex: 0 0 3px; width: 3px; height: 18px; border-radius: 2px; background: #46C2AF;"></span>Gli strumenti</button>
        <button type="button" data-go="percorso" data-anim="1" style="display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px; border-radius: 10px; border: 0; background: transparent; color: var(--ink); font-family: inherit; font-size: 16px; text-align: left; cursor: pointer;"><span aria-hidden="true" style="flex: 0 0 3px; width: 3px; height: 18px; border-radius: 2px; background: #46C2AF;"></span>Il mio percorso in 5 tappe</button>
        <button type="button" data-go="contatti" data-umami-event="menu-contatti" data-anim="1" style="display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px; border-radius: 10px; border: 0; background: transparent; color: var(--ink); font-family: inherit; font-size: 16px; text-align: left; cursor: pointer;"><span aria-hidden="true" style="flex: 0 0 3px; width: 3px; height: 18px; border-radius: 2px; background: #46C2AF;"></span>Raccontami la tua realtà</button>
        </div>
      </div>
    </nav>
  </header>

  <!-- APERTURA -->
  <section id="top" class="hero" style="max-width: 1200px; margin: 0 auto; padding: clamp(32px, 8vw, 112px) clamp(20px, 4vw, 32px) clamp(72px, 9vw, 120px);">
    <div class="hero-row" style="display: flex; flex-wrap: wrap; align-items: center; gap: clamp(28px, 4vw, 48px) 64px;">
      <div class="hero-photo" style="flex: 0 1 380px; min-width: 0;">
        <img src="/img/odoardo-ritratto.jpg" alt="Ritratto di Odoardo Vitolo" style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center; border-radius: 20px;">
        <p class="hero-role" style="margin: 12px 0 0; text-align: center; text-wrap: balance; font-size: 14px; line-height: 1.45; color: var(--muted);"><span style="display: block; font-weight: 700; letter-spacing: 0.08em;">ODOARDO VITOLO</span>Fractional&nbsp;CMO&nbsp;| Marketing&nbsp;Manager</p>
      </div>
      <div style="flex: 1 1 520px; min-width: 0;">
        <h1 style="margin: 0; font-size: clamp(36px, 5vw, 64px); line-height: 1.05; font-weight: 700; letter-spacing: -0.02em;">Direzione marketing per&nbsp;PMI&nbsp;e&nbsp;professionisti</h1>
        <p class="hero-sub" style="margin: 28px 0 0; max-width: 570px; font-size: clamp(18px, 2vw, 24px); line-height: 1.4; color: var(--muted);">Definisco le priorità, coordino agenzie e specialisti. Misuro cosa rende. Da oltre 6 anni lavoro sui numeri del marketing.</p>
        <div class="hero-cta" style="margin-top: 28px; max-width: 570px; display: flex; justify-content: center;">
          <button type="button" data-go="contatti" data-umami-event="cta-apertura" style="background: #46C2AF; color: #FFFFFF; border: 0; border-radius: 999px; padding: 16px 28px; min-height: 48px; font-family: inherit; font-size: 16px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 8px;">Conosciamoci<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 18px; overflow: visible;"><path d="M4 10h12v3.5a5.5 5.5 0 0 1-5.5 5.5h-1A5.5 5.5 0 0 1 4 13.5V10z"></path><path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"></path><path class="steam-1" d="M8 7c-.9-1 .9-2 0-3.5"></path><path class="steam-2" d="M12 7c-.9-1 .9-2 0-3.5"></path></svg></button>
        </div>
      </div>
    </div>
  </section>

  <!-- DA DOVE PARTI -->
  <section id="da-dove-parti" style="background: var(--alt);">
    <div style="max-width: 1200px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 32px);">
      <h2 style="margin: 0; display: flex; align-items: center; gap: 0.35em; font-size: clamp(30px, 4vw, 56px); font-weight: 700; letter-spacing: -0.02em; color: var(--ink);"><span aria-hidden="true" style="flex: 0 0 auto; width: 0.05em; min-width: 2px; height: 1.15em; border-radius: 3px; background: #46C2AF;"></span>Da dove parti?</h2>
      <div style="margin-top: clamp(32px, 4vw, 48px); display: flex; flex-wrap: wrap; gap: 24px;">
        <button type="button" data-go="contatti" data-umami-event="scelta-ho-gia-agenzia" style="flex: 1 1 400px; text-align: left; font-family: inherit; background: #46C2AF; cursor: pointer; color: #FFFFFF; border: 0; border-radius: 20px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-size: clamp(24px, 2.6vw, 30px); font-weight: 700; letter-spacing: -0.01em;">Hai già un'agenzia?</span>
          <span class="card-desc" style="font-size: clamp(18px, 2vw, 24px); line-height: 1.35; text-wrap: balance; color: #FFFFFF;">Ti supporto nella decisione delle priorità e ne misuro i risultati.</span>
          <span style="margin-top: 8px; width: 24px; height: 2px; background: #FFFFFF;"></span>
        </button>
        <button type="button" data-go="contatti" data-umami-event="scelta-da-zero" style="flex: 1 1 400px; text-align: left; font-family: inherit; background: var(--card2); cursor: pointer; color: var(--cardInk); border: 0; border-radius: 20px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 12px;">
          <span style="font-size: clamp(24px, 2.6vw, 30px); font-weight: 700; letter-spacing: -0.01em;">Il tuo marketing parte da zero?</span>
          <span class="card-desc" style="font-size: clamp(18px, 2vw, 24px); line-height: 1.35; text-wrap: balance; color: var(--cardMuted);">Costruisco la strategia e coordino gli specialisti.</span>
          <span style="margin-top: 8px; width: 24px; height: 2px; background: #46C2AF;"></span>
        </button>
      </div>
    </div>
  </section>

  <!-- STRUMENTI -->
  <section id="strumenti" style="background: var(--soft);">
    <div style="max-width: 1200px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 32px);">
      <h2 style="margin: 0; display: flex; align-items: center; gap: 0.35em; font-size: clamp(30px, 4vw, 56px); font-weight: 700; letter-spacing: -0.02em;"><span aria-hidden="true" style="flex: 0 0 auto; width: 0.05em; min-width: 2px; height: 1.15em; border-radius: 3px; background: #46C2AF;"></span>Gli strumenti</h2>

      <div class="tool-row" style="margin-top: clamp(40px, 5vw, 64px); display: flex; gap: 24px;">

        <article class="tool-card" style="flex: 1 1 0; min-width: 0; background: #46C2AF; color: #FFFFFF; border-radius: 20px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column;">
          <span class="tool-eye lbl" style="font-size: 13px; line-height: 1.2; font-weight: 700; color: #FFFFFF;">COSA FARE?</span>
          <span class="tool-title" style="margin-top: 18px; font-size: 30px; line-height: 1.15; font-weight: 700;">Roadmap</span>
          <p class="tool-desc" style="margin: 22px 0 0; text-wrap: balance; font-size: 24px; line-height: 1.35; color: #FFFFFF;">Le priorità dello studio, in ordine, con chi fa cosa.</p>
        </article>

        <article class="tool-card" style="flex: 1 1 0; min-width: 0; background: var(--card3); color: var(--cardInk); border-radius: 20px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column;">
          <span class="tool-eye lbl" style="font-size: 13px; line-height: 1.2; font-weight: 700; color: #46C2AF;">COSA SUCCEDE?</span>
          <span class="tool-title" style="margin-top: 18px; font-size: 30px; line-height: 1.15; font-weight: 700;">Report</span>
          <p class="tool-desc" style="margin: 22px 0 0; text-wrap: balance; font-size: 24px; line-height: 1.35; color: var(--cardMuted);">Fatturato e margini in una pagina.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- PERCORSO -->
  <section id="percorso" style="background: var(--band); color: var(--bandInk);">
    <div style="max-width: 1200px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 32px);">
      <h2 style="margin: 0; display: flex; align-items: center; gap: 0.35em; font-size: clamp(30px, 4vw, 56px); font-weight: 700; letter-spacing: -0.02em; color: var(--bandInk);"><span aria-hidden="true" style="flex: 0 0 auto; width: 0.05em; min-width: 2px; height: 1.15em; border-radius: 3px; background: #46C2AF;"></span>Il mio percorso in 5 tappe</h2>

      <div class="tl" style="margin-top: clamp(48px, 6vw, 72px);">
        <div class="tl-line" aria-hidden="true" style="background: var(--bandLine);"></div>

        <div class="tl-item tl-left">
          <span class="tl-dot" aria-hidden="true" style="background: #46C2AF;"></span>
          <div class="tl-body">
            <h3 class="tl-head" style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--bandInk);">2020 | Le origini</h3>
            <p class="tl-text" style="margin: 0; font-size: 16px; line-height: 1.55; color: var(--bandInk);">Studio dei meccanismi che rendono una campagna di marketing virale e primi passi in agenzia.</p>
          </div>
        </div>

        <div class="tl-item tl-right">
          <span class="tl-dot" aria-hidden="true" style="background: #46C2AF;"></span>
          <div class="tl-body">
            <h3 class="tl-head" style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--bandInk);">2021–22 | Dai canali ai sistemi</h3>
            <p class="tl-text" style="margin: 0; font-size: 16px; line-height: 1.55; color: var(--bandInk);">Avvio del canale SMS Marketing, contributo all’ideazione di un CRM proprietario e regia del canale Email Marketing.</p>
            <button type="button" class="tl-btn" data-case-toggle="canali" data-umami-event="caso-canali" aria-expanded="false">Approfondisci il caso</button>
            <div class="tl-case" data-case="canali" hidden>
              <div class="tl-panel" style="background: var(--bandPanel);">
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Situazione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">L’agenzia lavorava solo con l’email marketing. I lead arrivavano ai clienti in file Excel via email e alcuni li lavoravano il giorno dopo.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Obiettivo</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Aprire un secondo canale, consegnare i lead più in fretta e far crescere ricavi e margine della DEM.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Azione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Avvio da zero del canale SMS. Contributo alla struttura del CRM proprietario, sviluppato dall’IT. Nella DEM: planning degli invii, storico dei prezzi trattati e doppio lancio.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Risultato</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">SMS: ricavi mensili ×6 nei primi 12 mesi. CRM: lead consegnati quasi in tempo reale. DEM: ricavi ×4, margine +12 punti.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tl-item tl-left">
          <span class="tl-dot" aria-hidden="true" style="background: #46C2AF;"></span>
          <div class="tl-body">
            <h3 class="tl-head" style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--bandInk);">2024–25 | Gestione delle criticità</h3>
            <p class="tl-text" style="margin: 0; font-size: 16px; line-height: 1.55; color: var(--bandInk);">Miglioramento record del tasso di conversione con cliente storico dal 14% al 25% in quattro mesi.</p>
            <button type="button" class="tl-btn" data-case-toggle="criticita" data-umami-event="caso-criticita" aria-expanded="false">Approfondisci il caso</button>
            <div class="tl-case" data-case="criticita" hidden>
              <div class="tl-panel" style="background: var(--bandPanel);">
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Situazione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Conversione del cliente scesa dal 19% al 14%: troppa pressione commerciale su una piccola parte del database.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Obiettivo</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Risalire almeno al 20% di conversione.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Azione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Utenti divisi per livello di attività negli ultimi 6 mesi. Lanci sugli utenti più attivi alternati a campagne di riattivazione sugli altri.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Risultato</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Record del 25% in quattro mesi.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tl-item tl-right">
          <span class="tl-dot" aria-hidden="true" style="background: #46C2AF;"></span>
          <div class="tl-body">
            <h3 class="tl-head" style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--bandInk);">2025 | Ottimizzazione dei processi</h3>
            <p class="tl-text" style="margin: 0; font-size: 16px; line-height: 1.55; color: var(--bandInk);">Ottimizzazione dei processi del call center interno, raggiungendo sotto la mia guida l’obiettivo di conversione del 10%, rispetto al 6,5% iniziale.</p>
            <button type="button" class="tl-btn" data-case-toggle="processi" data-umami-event="caso-processi" aria-expanded="false">Approfondisci il caso</button>
            <div class="tl-case" data-case="processi" hidden>
              <div class="tl-panel" style="background: var(--bandPanel);">
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Situazione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Conversione dei contratti al 6,5% e dati delle lavorazioni poco leggibili per il management.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Obiettivo</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Portare la conversione dei contratti al 10%.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Azione</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Analisi delle attitudini di ogni operatore negli ultimi 6 mesi. Tutti gli operatori su più campagne, per limitare il burnout: lavorarne diverse, e non una sola, li aiutava anche mentalmente. Affiancamento per chi era in difficoltà, report giornaliero e ideazione di un file per la gestione delle obiezioni.</p>
                </div>
                <div class="tl-cell">
                  <span class="lbl" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #46C2AF;">Risultato</span>
                  <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--bandInk);">Conversione dei contratti dal 6,5% al 10%, obiettivo raggiunto.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tl-item tl-left">
          <span class="tl-dot" aria-hidden="true" style="background: var(--band); border: 4px solid #46C2AF;"></span>
          <div class="tl-body">
            <h3 class="tl-head" style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--bandInk);">2026 | Una nuova direzione</h3>
            <p class="tl-text" style="margin: 0; font-size: 16px; line-height: 1.55; color: var(--bandInk);">Porto l’esperienza maturata nel performance marketing al servizio di PMI e professionisti, con particolare attenzione al settore sanitario.</p>
            <button type="button" class="tl-btn" data-case-toggle="direzione" data-umami-event="caso-direzione" aria-expanded="false">Approfondisci il caso</button>
            <div class="tl-case" data-case="direzione" hidden>
