<script is:inline>
(function(){
  var root=document.documentElement, body=document.body, n=0;
  var svg=document.querySelector('.logo-svg'), path=document.querySelector('.logo-path');
  var themeBtn=document.querySelector('[data-action="theme"]'), menuBtn=document.querySelector('[data-action="menu"]');
  function setMenu(open){
    body.classList.toggle('menu-open',open);
    menuBtn.setAttribute('aria-expanded',open?'true':'false');
    var l=open?'Chiudi il menu':'Apri il menu'; menuBtn.setAttribute('aria-label',l); menuBtn.title=l;
  }
  function spinLogo(){
    n++; var a=n%2?'a':'b', b=n%2?'b':'a';
    svg.classList.remove('logo-spin-'+b); path.classList.remove('logo-draw-'+b);
    svg.classList.add('logo-spin-'+a); path.classList.add('logo-draw-'+a);
  }
  document.addEventListener('click',function(e){
    var t=e.target.closest('[data-go],[data-action],[data-case-toggle]'); if(!t) return;
    if(t.dataset.go){
      e.preventDefault(); setMenu(false); if(t.dataset.anim) spinLogo();
      var el=document.getElementById(t.dataset.go); if(el) el.scrollIntoView({block:'start'});
    } else if(t.dataset.action==='theme'){
      var dark=root.getAttribute('data-theme')!=='dark';
      if(dark) root.setAttribute('data-theme','dark'); else root.removeAttribute('data-theme');
      var l=dark?'Passa al tema chiaro':'Passa al tema scuro'; t.setAttribute('aria-label',l); t.title=l;
    } else if(t.dataset.action==='menu'){
      setMenu(!body.classList.contains('menu-open'));
    } else if(t.dataset.caseToggle){
      var key=t.dataset.caseToggle;
      document.querySelectorAll('[data-case-toggle]').forEach(function(b){
        var p=document.querySelector('.tl-case[data-case="'+b.dataset.caseToggle+'"]');
        var open=(b.dataset.caseToggle===key)&&p.hidden;
        p.hidden=!open; b.textContent=open?'Chiudi':'Approfondisci il caso'; b.setAttribute('aria-expanded',open?'true':'false');
      });
    }
  });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') setMenu(false); });
})();
</script>
